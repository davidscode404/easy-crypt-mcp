#!/bin/sh
# Start the EasyCrypt MCP server in Docker with the current directory mounted at the same path,
# so file paths mean the same thing on the host and inside the container.
# Used by .mcp.json (Claude Code picks it up when you open this repo); also fine by hand:
#   claude mcp add easycrypt -- sh bin/easycrypt-mcp
set -eu
IMAGE="${EASYCRYPT_IMAGE:-ghcr.io/davidscode404/easy-crypt-mcp:main}"
exec docker run -i --rm --platform linux/amd64 \
  -v "$PWD:$PWD" -w "$PWD" \
  -e EASYCRYPT_ROOT="$PWD" \
  -e EASYCRYPT_ARGS="${EASYCRYPT_ARGS:--timeout 10}" \
  "$IMAGE"
